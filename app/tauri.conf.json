{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodestro",
  "version": "0.2.0-preview.1",
  "identifier": "org.nodestro.desktop",
  "build": { "frontendDist": "ui" },
  "app": {
    "windows": [],
